# Copy to .env locally. Never share your key.
GEMINI_API_KEY=
# Select an available tool-capable model during Phase 3.
GEMINI_MODEL=
# Optional reliability settings (defaults shown; no secret values here).
# Requests are paced across sessions within ONE app process; these do not raise quota.
# FW_GEMINI_INTERVAL_SECONDS=13
# FW_GEMINI_ATTEMPTS=3
# FW_GEMINI_MAX_REQUESTS_PER_ANALYSIS=6
# FW_GEMINI_REQUEST_BUDGET_SECONDS=95
# FW_GEMINI_ANALYSIS_BUDGET_SECONDS=180
# FW_GEMINI_TIMEOUT_MS=30000
